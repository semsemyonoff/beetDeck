# Copy to .env and adjust. Consumed by docker-compose.yml.

# Published image + tag to run. Pin to a release (e.g. 1.0.0) in production;
# `latest` is fine for trying it out.
BEETDECK_IMAGE=semsemyonoff/beetdeck
BEETDECK_TAG=latest

# Host port the UI/API is exposed on (container always serves on 5000).
BEETDECK_HTTP_PORT=8080

# Host paths bind-mounted into the container.
#   config/ — your beets config.yaml (BEETSDIR)
#   music/  — your audio library / import dir
BEETDECK_CONFIG_DIR=./config
BEETDECK_MUSIC_DIR=./music

# Keep what the cover-art gallery downloads, permanently, in the beetdeck_artwork
# volume — re-opening a gallery then never goes back to the Cover Art Archive.
# EMPTY means no mirror: the same images land in a 512 MB / 7-day cache inside
# the container and are re-fetched after it is recreated. The only value that
# makes sense is the container path the volume is mounted at:
#   BEETDECK_ARTWORK_DIR=/data/artwork
# Nothing prunes the mirror; reclaim it with `docker volume rm beetdeck_artwork`.
BEETDECK_ARTWORK_DIR=

# Container timezone (affects logs / timestamps).
TZ=UTC

# ---- MCP server (optional) -------------------------------------------------
# Only read by the `mcp` compose profile:  docker compose --profile mcp up -d
# Leave this block alone if you don't want an AI agent talking to your library.

# Bearer token agents must present. REQUIRED for the profile — the server
# refuses to start without it, and it is the main thing standing between the
# network and write access to your tags. Generate one:
#   openssl rand -hex 24
# Comma-separate to issue more than one.
BEETDECK_MCP_TOKEN=

# Sent to MusicBrainz on every lookup; they reject anonymous clients, so this is
# REQUIRED too. Use something identifying, with a way to contact you, e.g.
#   beetDeck/0.4.0 ( you@example.com )
MUSICBRAINZ_USER_AGENT=

# Host port for the MCP endpoint (container always serves on 5100).
BEETDECK_MCP_PORT=5100

# Comma-separated hostnames allowed in the Host/Origin headers (DNS-rebinding
# protection). EMPTY DISABLES THE CHECK ENTIRELY — it does not fall back to
# localhost. Set it to whatever you publish the endpoint as.
BEETDECK_MCP_ALLOWED_HOSTS=

# true = the agent can preview changes but never commit them. This gates the
# apply step only: previews still fetch remote data, and rescan / BPM compute /
# ignore-toggle sit outside the preview contract and keep working.
BEETDECK_MCP_READONLY=false
