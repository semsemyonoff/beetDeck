# Example beets configuration for a beetDeck deployment.
#
# Copy this into the config dir mounted at /config (BEETSDIR), e.g.:
#   mkdir -p config && cp config.yaml.example config/config.yaml
#
# The `directory` and `library` paths below are CONTAINER paths and match the
# mounts in docker-compose.yml — keep them as-is unless you change the mounts.
# All plugins use `auto: no`: beetDeck triggers them on demand from the UI.

directory: /music
library: /data/beets/library.db
# beets' incremental-import history. It defaults to `state.pickle` *relative to
# BEETSDIR*, which is wrong for this layout twice over: the config dir is a
# committed artifact that has no business holding mutable binary state, and a
# deployment that mounts it read-only (a reasonable thing to do) leaves beets
# unable to write the history at all. It fails silently — one
# "state file could not be written" line per album in the rescan log — and
# `incremental: yes` below then skips nothing, so every quick scan re-reads the
# tags of the entire library. Keep it in the data volume, next to library.db.
statefile: /data/beets/state.pickle

import:
  copy: no
  move: no
  write: yes
  # Only effective together with a writable `statefile` above.
  incremental: yes
  # `remove`, not `skip`: re-importing a track you replaced with another format
  # (mp3 -> flac) must swap the old item out in one pass. With `skip` the track
  # vanishes on the first rescan and only comes back on the second.
  duplicate_action: remove

plugins:
  - musicbrainz
  - fetchart
  - embedart
  - lastgenre
  - lyrics
  - autobpm
  - info

musicbrainz:
  # Already the beets default — written out as an anchor, not as a fix. beetDeck
  # never raises it: its MusicBrainz genre source reads the release's genre lists
  # itself, and the metadata sync strips genres out of the diff. `yes` here would
  # make a rescan's `beet import` write MusicBrainz genres over whatever you
  # fetched from Last.fm.
  genres: no

fetchart:
  auto: no
  high_resolution: yes
  sources:
    - filesystem
    - coverart
    - itunes
    - amazon
    - albumart
  minwidth: 500
  maxwidth: 1200
  store_source: yes

embedart:
  auto: no
  ifempty: yes

lastgenre:
  auto: no
  count: 3
  source: album

lyrics:
  auto: no
  sources: [lrclib]
  synced: yes

autobpm:
  auto: no
